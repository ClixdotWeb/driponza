# ── Core ─────────────────────────────────────────────
# Coolify: copy the "Postgres URL (internal)" from your Coolify PostgreSQL resource.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/driponza"
# Public URL of the site, no trailing slash (used in emails and Razorpay callbacks).
APP_URL="https://driponza.example.com"
# Long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# ── Razorpay (AWAITING CREDENTIALS) ─────────────────
# Dashboard → Settings → API Keys. Use rzp_test_… keys first.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard → Settings → Webhooks → URL: {APP_URL}/api/webhooks/razorpay
# Events: payment.captured, payment.failed, order.paid, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=""

# ── Image storage ────────────────────────────────────
# If all three Cloudinary values are set, uploads go to Cloudinary.
# Otherwise files are saved to UPLOAD_DIR (mount a persistent volume there in Coolify).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
UPLOAD_DIR="/app/uploads"

# ── Email (password reset & order emails) ────────────
# If SMTP is not configured, emails are written to the server log instead of being sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Driponza <no-reply@example.com>"

# ── Seeding ──────────────────────────────────────────
# The source site has no stock figures, so seeded variants start at 0 unless set here.
SEED_STOCK="0"
