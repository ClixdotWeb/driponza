# Placeholders only – never commit real values. See docs/ENVIRONMENT_SETUP.md.

# ── Core ─────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/driponza"
# Non-pooled connection for migrations (Neon "direct" URL / Coolify internal URL)
DIRECT_DATABASE_URL=""
# Public site URL, no trailing slash (used in emails and links)
APP_URL="https://driponza.example.com"
NEXT_PUBLIC_APP_URL="https://driponza.example.com"
# 48+ random bytes: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
# Protects /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=""

# ── Image storage: Coolify MinIO / any S3-compatible store (preferred) ──
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="driponza"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
# Public base URL of the bucket, e.g. https://minio.yourdomain/driponza
S3_PUBLIC_URL=""
# Max upload size in bytes (default 8 MB)
S3_UPLOAD_MAX_SIZE="8388608"
# Fallbacks used only when S3_* is not set: Vercel Blob (set automatically by Vercel), then local disk
BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR="/app/uploads"

# ── Email (SMTP). Without SMTP_HOST, emails are logged as SKIPPED in NotificationLog ──
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Driponza <no-reply@example.com>"
# Receives new-order, payment-to-verify, return and low-stock alerts
ADMIN_NOTIFY_EMAIL=""

# ── Future online payment gateway (NOT integrated – leave unset) ──
PAYMENT_GATEWAY_ENABLED=""

# Bank details, COD, shipping zones, GSTIN and policies are business settings edited in
# Admin → Settings / Shipping / Content and stored in the database – not environment variables.

# ── Seeding ──────────────────────────────────────────
SEED_STOCK="0"
